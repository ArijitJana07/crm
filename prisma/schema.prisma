// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("EMPLOYEE") // SUPER_ADMIN, MANAGER, TEAM_LEADER, EMPLOYEE, CLIENT
  department    String? // SEO, PPC, WEB_DEV, etc.
  accounts      Account[]
  sessions      Session[]
  projects      Project[] // Projects assigned to or managed by the user
  tasks         Task[] // Tasks assigned to the user
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  department  String // Which department owns this project
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED, ON_HOLD
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[] // Users assigned to this project
  tasks Task[]
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("TODO") // TODO, IN_PROGRESS, DONE
  projectId   String
  assigneeId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
}

// Model to store Google API credentials centrally (for server-to-server or general usage if needed)
// Although NextAuth stores user specific oauth tokens in Account, this can store global ones if ever needed
model GoogleCredential {
  id           String   @id @default(cuid())
  accessToken  String
  refreshToken String
  expiresAt    Int
  scope        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
